# Public clients should reach TCP/443. The service grants CAP_NET_BIND_SERVICE for this.
RELAYD_PUBLIC_ADDR=:443
# If carrier clients need strict 443 egress, bind this on a separate local IP's :443 or
# front :9443 with a TCP proxy/NAT endpoint. It cannot share the public listener's IP:443.
RELAYD_CARRIER_ADDR=:9443
RELAYD_ADMIN_ADDR=127.0.0.1:9080
# The admin listener refuses to start on a non-loopback, non-private RELAYD_ADMIN_ADDR unless you
# opt in here, and a non-loopback bind additionally requires RELAYD_ADMIN_METRICS_TOKEN_FILE (or
# RELAYD_ADMIN_METRICS_TOKEN) so /metrics is not exposed without a credential. Leave both unset for
# the default loopback-only admin listener.
# RELAYD_ADMIN_ALLOW_PUBLIC=true
# RELAYD_ADMIN_METRICS_TOKEN_FILE=/etc/beamfall-relay/admin-metrics-token
# ADR-0018 v2 QUIC carrier listener (UDP), in addition to the TLS/TCP carrier above. Empty (the
# default) disables it; set only if your tunnel clients dial the QUIC carrier.
# RELAYD_QUIC_ADDR=:9444
RELAYD_CARRIER_CERT=/etc/beamfall-relay/carrier.crt
RELAYD_CARRIER_KEY=/etc/beamfall-relay/carrier.key
RELAYD_TOKEN_FILE=/etc/beamfall-relay/token
# HMAC is the production default. Static tokens are development-only behind BEAMFALL_RELAY_DEV=1.
RELAYD_TOKEN_MODE=hmac
RELAYD_HOSTNAMES=home.relay.example
RELAYD_STREAM_CAP=64
RELAYD_MAX_PUBLIC_CONNS=1024
RELAYD_FAIR_USE_ENABLED=false
RELAYD_FAIR_USE_WINDOW_DAYS=30
RELAYD_FAIR_USE_SOFT_LIMIT_BYTES=0
RELAYD_FAIR_USE_HARD_LIMIT_BYTES=0
RELAYD_FAIR_USE_THROTTLED_MAX_CONNS=4
RELAYD_FAIR_USE_STORE=memory
# Hosted multi-instance only; load this credential from a 0600 EnvironmentFile.
# RELAYD_FAIR_USE_REDIS_URL=rediss://user:password@redis.internal:6379/0
# Redis mode only; must remain on persistent local storage with POSIX lock,
# atomic-rename, and directory-fsync semantics.
RELAYD_FAIR_USE_OUTBOX=/var/lib/beamfall-relay/fairuse-outbox.json
