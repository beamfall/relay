[Unit]
Description=Beamfall Self-hosted Relay
Documentation=https://github.com/beamfall/relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=beamfall-relay
Group=beamfall-relay
EnvironmentFile=/etc/beamfall-relay/relayd.env
# Creates /var/lib/beamfall-relay owned by User/Group and keeps that state path
# writable under ProtectSystem=strict for the HMAC replay nonce store and
# Redis fair-use final-delta outbox.
StateDirectory=beamfall-relay
StateDirectoryMode=0700
ExecStart=/usr/local/bin/relayd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
# Bounds this unit's resident memory. Sizing rule: MemoryMax must be at least
# --stream-memory-budget-bytes plus 128 MiB of headroom. The shipped defaults are 320 MiB + 128 MiB
# = 448 MiB, inside 512M.
# - The stream memory budget covers what relayed streams buffer. A public client that stops
#   reading lets the home fill one carrier stream window (--yamux-stream-window-bytes, 4 MiB by
#   default) in relayd, held in a buffer that can reach twice that size, or one 8 MiB QUIC stream
#   window when the QUIC carrier is on. relayd carries at most budget / that per-stream cost
#   streams at once (40 at the defaults) and refuses the rest, and it closes a stream whose client
#   accepts no bytes for --client-write-stall-timeout (5m).
# - The headroom covers the 32 KiB per-direction splice buffers of the streams relayd carries,
#   goroutine and TLS state for up to --max-public-conns connections, and the fair-use and
#   replay-nonce maps.
# - MemoryMax also charges kernel socket buffers, which the budget does not count: a stalled
#   client can hold a few more MiB of unsent data per stream in the kernel.
# relayd sets the Go runtime's soft memory limit to budget + headroom unless GOMEMLIMIT is set.
# To carry more streams, raise --stream-memory-budget-bytes and MemoryMax together, or lower the
# stream window on both relay and tunnel client. Raise MemoryMax too if you raise
# --max-public-conns well above its default, and check `systemctl status beamfall-relayd` (or
# the cgroup's memory.peak) under your real traffic.
MemoryMax=512M
# Each accepted public or carrier TCP connection holds one file descriptor for the life of the
# connection (yamux multiplexes a carrier's streams over its single socket, so streams do not add
# further fds); the listener sockets, HMAC nonce store, and fair-use outbox add a handful more. The
# default --max-public-conns (1024) plus --max-carrier-conns (256) already approach a typical distro
# default of 1024 open files, so this raises the ceiling well above the shipped connection caps.
LimitNOFILE=65536
# Journald retains this unit's logs indefinitely by default, which contradicts the published
# operational-log retention window (24h; see docs/relay-threat-model.md "Retention Bounds"). Bound
# it with a per-unit journald drop-in, e.g. /etc/systemd/journald@beamfall-relayd.conf.d/retention.conf:
#   [Journal]
#   MaxRetentionSec=1day
# or scope it to the whole journal in /etc/systemd/journald.conf.d/beamfall-relay-retention.conf.
# See docs/operator-self-hosted-relay.md for the full drop-in walkthrough.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
PrivateDevices=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true
LockPersonality=true
SystemCallFilter=@system-service
UMask=0077
ProtectProc=invisible

[Install]
WantedBy=multi-user.target
