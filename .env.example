# Beamfall Relay — example environment.
# Copy to .env (or your secrets manager) and fill in. Do NOT commit real secrets.
# Every variable below maps 1:1 to a relayd/tunnel-client flag; flags override env.
# A relayd-only systemd variant lives at packaging/systemd/relayd.env.example.

# ---------------------------------------------------------------------------
# relayd (the relay daemon)
# ---------------------------------------------------------------------------

# Public TLS passthrough listener (clients connect here). Binary default :8443; expose as external 443.
RELAYD_PUBLIC_ADDR=:8443
# Carrier TLS 1.3 listener (home-server tunnel clients connect here). Binary default :9443;
# expose as external 443 on a distinct IP/host/proxy when home-server egress is 443-only.
RELAYD_CARRIER_ADDR=:9443
# Admin listener for /healthz and /metrics. Bind to localhost/private only. Default 127.0.0.1:9080
RELAYD_ADMIN_ADDR=127.0.0.1:9080
# ADR-0103: any transient operational log MUST be purged within the bounded retention window
# published on /metrics as beamfall_relay_log_retention_seconds (build-time constant
# OperationalLogRetentionWindow, ceiling MaxOperationalLogRetention = 7d). The relay logs to
# stdout/journal only; enforce the purge in the deployment (journald MaxRetentionSec / logrotate).

# TLS certificate presented by the carrier listener (path).
RELAYD_CARRIER_CERT=/etc/beamfall-relay/carrier.crt
# Private key for RELAYD_CARRIER_CERT (path). # SECRET (the key file is sensitive)
RELAYD_CARRIER_KEY=/etc/beamfall-relay/carrier.key

# Shared self-hosted tunnel token, inline. Discouraged — prefer RELAYD_TOKEN_FILE. If you must
# set it inline, keep this .env at 0600; surrounding whitespace is trimmed. # SECRET
RELAYD_TOKEN=
# Path to a 0600 file holding the shared tunnel token (preferred over RELAYD_TOKEN). # SECRET
RELAYD_TOKEN_FILE=/etc/beamfall-relay/token

# Carrier token verification mode: 'hmac' (production default; the token value is a shared SECRET
# and carriers present expiring, replay-resistant v2 tunnel tokens minted from it). 'static'
# presents the token as-is, is replayable if captured, and is development-only behind
# BEAMFALL_RELAY_DEV=1. Must match the tunnel client's TUNNEL_TOKEN_MODE.
RELAYD_TOKEN_MODE=hmac

# Comma-separated hostnames this relay accepts. At least one is required.
RELAYD_HOSTNAMES=home.relay.example

# Max concurrent public-to-backend streams per carrier. Default 64.
RELAYD_STREAM_CAP=64

# Max concurrently-handled public connections (internet-facing flood ceiling).
# Over the cap, accepts are closed and beamfall_relay_public_over_cap_total rises.
# 0 uses the built-in default. Default 1024
RELAYD_MAX_PUBLIC_CONNS=1024

# Fair-use accounting (optional; all counted bytes are encrypted, never inspected).
RELAYD_FAIR_USE_ENABLED=false
RELAYD_FAIR_USE_WINDOW_DAYS=30
RELAYD_FAIR_USE_SOFT_LIMIT_BYTES=0
RELAYD_FAIR_USE_HARD_LIMIT_BYTES=0
RELAYD_FAIR_USE_THROTTLED_MAX_CONNS=4
# Shared hosted mode: Redis plus a local persistent, private write-ahead outbox.
RELAYD_FAIR_USE_STORE=memory
# RELAYD_FAIR_USE_REDIS_URL=rediss://user:password@redis.internal:6379/0
RELAYD_FAIR_USE_OUTBOX=/var/lib/beamfall-relay/fairuse-outbox.json

# ---------------------------------------------------------------------------
# tunnel-client (runs next to the home server)
# ---------------------------------------------------------------------------

# Relay carrier address to dial. Use :443 for strict-egress networks.
TUNNEL_RELAY_ADDR=relay-carrier.example:443
# Home-server backend TLS address to forward inbound streams to. Required.
TUNNEL_BACKEND_ADDR=127.0.0.1:8443
# Comma-separated hostnames this tunnel serves. At least one is required.
TUNNEL_HOSTNAMES=home.relay.example

# Shared tunnel token, inline. Discouraged — prefer TUNNEL_TOKEN_FILE. If you must set it inline,
# keep this .env at 0600; surrounding whitespace is trimmed. # SECRET
TUNNEL_TOKEN=
# Path to a 0600 file holding the shared tunnel token (preferred over TUNNEL_TOKEN). # SECRET
TUNNEL_TOKEN_FILE=/etc/beamfall-relay/token

# Carrier token mode: 'hmac' (production default; treat the token as a shared SECRET and mint a
# fresh expiring, replay-resistant v2 tunnel token on every carrier dial). 'static' presents the
# token as-is, is replayable if captured, and is development-only behind BEAMFALL_RELAY_DEV=1.
# Must match the relay's RELAYD_TOKEN_MODE.
TUNNEL_TOKEN_MODE=hmac

# hmac token mode only: validity window of each minted v2 token (Go duration, e.g. 1m, 5m).
# The relay tears the carrier session down at token expiry and this client immediately
# reconnects with a fresh token — shorter bounds a captured token tighter at the cost of a
# brief reconnect blip per TTL. Binary default 5m; MaxHMACTokenTTL ceiling 5m.
TUNNEL_TOKEN_TTL=5m

# Path to the relay carrier CA PEM used to verify the carrier TLS connection.
TUNNEL_RELAY_CA=/etc/beamfall-relay/carrier-ca.pem
